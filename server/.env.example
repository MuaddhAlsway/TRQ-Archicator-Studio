# ============ GMAIL SETUP ============
# Email sending via Gmail with App Password
# 
# Setup Instructions:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Google will generate a 16-character app password
# 5. Copy the app password and paste it below (remove spaces)
# 6. Set GMAIL_USER to your Gmail address

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=fbxwzpqrbyehvsmi

# ============ JWT ============
JWT_SECRET=your-secret-key-here
