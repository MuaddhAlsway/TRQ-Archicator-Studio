{
  "name": "trq-workers-api",
  "version": "1.0.0",
  "description": "TRQ API - Cloudflare Workers Backend",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm install --legacy-peer-deps && vite build",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 execute trq-db --file migrations/001_init_schema.sql",
    "db:query": "wrangler d1 execute trq-db --command",
    "kv:list": "wrangler kv:key list --namespace-id",
    "r2:list": "wrangler r2 object list trq-media",
    "logs": "wrangler tail"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "gsap": "^3.15.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "itty-router": "^4.0.0",
    "itty-router-extras": "^0.4.0",
    "lucide-react": "^1.14.0",
    "quill": "^2.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-quill": "^2.0.0",
    "react-scroll-parallax": "^3.5.0",
    "recharts": "^3.8.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.9.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10",
    "wrangler": "^3.0.0"
  }
}
